from typing_extensions import Buffer

def IsCrd() -> bool: ...
def IsCuda() -> bool: ...
def GetImGuiContext() -> int: ...
def GetImPlotContext() -> int: ...

class Window:
  """Native window. Present accepts a contiguous buffer or None."""

  def __init__(
    self, title: str, width: int, height: int, graphics_mode_str: str, /
  ) -> None: ...
  def NewFrame(self) -> bool: ...
  def Present(self, pixels: Buffer | None = None) -> None:
    """Present a C-contiguous buffer or display the direct render target."""
  def GetWidth(self) -> int: ...
  def GetHeight(self) -> int: ...
  def GetScale(self) -> float: ...
  def GetGraphicsMode(self) -> int: ...
  def GetDropFile(self) -> str: ...
  def GetNativeWindowHandle(self) -> int: ...
