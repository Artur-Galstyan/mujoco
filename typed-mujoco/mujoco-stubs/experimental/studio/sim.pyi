from typing import ClassVar

from mujoco import MjData, MjModel

class StepStatus:
  __members__: ClassVar[dict[str, StepStatus]]
  OK: ClassVar[StepStatus]
  PAUSED: ClassVar[StepStatus]
  AUTO_RESET: ClassVar[StepStatus]
  DIVERGED: ClassVar[StepStatus]
  def __init__(self, value: int) -> None: ...
  def __int__(self) -> int: ...
  def __index__(self) -> int: ...
  @property
  def name(self) -> str: ...
  @property
  def value(self) -> int: ...

class PauseState:
  __members__: ClassVar[dict[str, PauseState]]
  UNPAUSED: ClassVar[PauseState]
  NORMAL_PAUSED: ClassVar[PauseState]
  def __init__(self, value: int) -> None: ...
  def __int__(self) -> int: ...
  def __index__(self) -> int: ...
  @property
  def name(self) -> str: ...
  @property
  def value(self) -> int: ...

class StepControl:
  """Physics step timing, pause state, speed, and noise controls."""

  def __init__(self) -> None: ...
  def advance(self, model: MjModel | None, data: MjData | None) -> StepStatus:
    """Step the model within the current time budget; report the result."""
  def force_sync(self) -> None: ...
  def get_speed(self) -> float: ...
  def get_speed_measured(self) -> float: ...
  def set_speed(self, speed: float) -> None: ...
  def set_pause_state(self, state: PauseState) -> None: ...
  def get_pause_state(self) -> PauseState: ...
  def request_single_step(self) -> None: ...
  def consume_single_step_request(self) -> bool: ...
  def get_noise_parameters(self) -> tuple[float, float]: ...
  def set_noise_parameters(
    self, noise_scale: float, noise_rate: float
  ) -> None: ...

class SimHistory:
  """A bounded history of simulation state; indices count backward from zero."""

  def __init__(self) -> None: ...
  def init(
    self, state_size: int, max_history: int = 2048, max_bytes: int = 134217728
  ) -> None:
    """Reset the bounded history for states with this many scalar values."""
  def get_index(self) -> int: ...
  def set_index(self, offset: int) -> None: ...
  def size(self) -> int: ...
  def set_size(self, size: int) -> None: ...
