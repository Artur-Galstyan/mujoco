class Context:
  """Owns Filament resources. Create this only when the backend is available."""

  def __init__(self, config: ContextConfig) -> None: ...
  def create_mesh(self, params: MeshConfig) -> Mesh: ...
  def create_texture(self, config: TextureConfig) -> Texture: ...
  def create_scene(self, params: SceneParams) -> Scene: ...
  def create_render_target(
    self, config: RenderTargetConfig
  ) -> RenderTarget: ...
  def create_light(self, params: LightParams) -> Light: ...
  def create_renderable(self, params: RenderableParams) -> Renderable: ...
  def render(
    self, req: Sequence[RenderRequest], read: Sequence[ReadPixelsRequest]
  ) -> int:
    """Submit render and read requests together; wait for the returned frame."""
  def wait_for_frame(self, frame: int) -> None: ...
