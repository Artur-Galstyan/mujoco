class Context:
  """Owns Filament resources. Create this only when the backend is available."""

  def __init__(self, config: ContextConfig) -> None: ...
  def create_mesh(self, config: MeshConfig) -> Mesh: ...
  def create_texture(self, config: TextureConfig) -> Texture: ...
  def create_scene(self, config: SceneParams) -> Scene: ...
  def create_render_target(
    self, config: RenderTargetConfig
  ) -> RenderTarget: ...
  def create_light(self, config: LightParams) -> Light: ...
  def create_renderable(self, config: RenderableParams) -> Renderable: ...
  def render(
    self, req: Sequence[RenderRequest], read: Sequence[ReadRequest]
  ) -> int:
    """Submit render and read requests together; wait for the returned frame."""
  def wait_for_frame(self, frame: int) -> None: ...
  def set_clear_color(self, color: npt.ArrayLike) -> None: ...
  def flush(self) -> None: ...
  def get_renderer_info(self, info: MjrRendererInfo) -> None: ...
  def get_frame_stats(self, frame: int, stats_out: FrameStats) -> None: ...

